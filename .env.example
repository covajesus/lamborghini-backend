SECRET_KEY=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
DEBUG=true
# Windows local often uses root without password.
# Ubuntu production: do NOT use root (error 1698). Use a dedicated user, e.g.:
# DATABASE_URL=mysql+pymysql://lb:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:3306/lb
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/lb
PERSISTENCE=sql
