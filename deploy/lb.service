[Unit]
Description=Lamborghini Colección API (lb)
After=network.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/lb/backend
EnvironmentFile=-/opt/lb/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lb/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 7776 --workers 2
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
